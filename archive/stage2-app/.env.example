# ─────────────────────────────────────────────────────────────
# Kanqaroo 환경변수 템플릿. 복사해서 .env.local 로 쓰기
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# 서비스 기본 URL (매직링크 리다이렉트, OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres 연결 문자열
#   로컬: docker compose up -d 후 아래 값 그대로
#   Supabase: Project Settings > Database > Connection string > Transaction pooler (6543)
#   Vercel Marketplace 연동 시 POSTGRES_URL 이 자동 주입되면 DATABASE_URL 은 비워도 됨
DATABASE_URL=postgres://kanqaroo:kanqaroo@127.0.0.1:54329/kanqaroo

# 세션 쿠키 암호화 키 (32자 이상 랜덤 문자열)
#   생성: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# 로그인 방식
#   supabase: 이메일 매직링크 (배포용)
#   dev: 이메일만 넣으면 바로 로그인 (로컬·테스트 전용, Vercel 위에서는 코드에서 막힘)
AUTH_MODE=dev

# Supabase Auth (AUTH_MODE=supabase 일 때 필요)
#   Project Settings > API 에서 확인. NEXT_PUBLIC_ 접두사 버전도 인식함
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 음악 데이터 공급자
#   itunes: iTunes Search + Odesli (배포용)
#   mock: 고정 샘플 데이터 (오프라인 개발·E2E 테스트용)
MUSIC_PROVIDER=mock

# (선택) Odesli API 키. 없으면 IP당 분당 약 10회 제한
ODESLI_API_KEY=
